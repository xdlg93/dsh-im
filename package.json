{
  "name": "@xdlg93/dsh-im",
  "version": "1.3.5",
  "icon": "./assets/logo-plugin-message-link-gradient.webp",
  "description": "把微信、QQ扫码接入DeepSeek Harness。 Connect WeChat and QQ to DSH via QR-code login.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "ai-agent",
    "im",
    "instant-messaging",
    "chatbot",
    "wechat",
    "weixin",
    "qq",
    "qr-login",
    "ai-office"
  ],
  "author": "xdlg93",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdlg93/dsh-im.git"
  },
  "homepage": "https://github.com/xdlg93/dsh-im#readme",
  "bugs": {
    "url": "https://github.com/xdlg93/dsh-im/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-im": "bin/dsh-im.mjs"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "assets",
    "bin",
    "cordis.patch.yml",
    "lib",
    "locale/*.json",
    "plugin-src",
    "scripts/verify-injected-context.mjs",
    "scripts/verify-lan-management.mjs",
    "scripts/verify-model-setting.mjs",
    "scripts/verify-package.mjs",
    "scripts/verify-session-channel-logos.mjs",
    "scripts/verify-session-title-prefix.mjs",
    "src",
    "PROACTIVE_DELIVERY.md",
    "PROACTIVE_DELIVERY.en.md",
    "docs/client-integration.md",
    "docs/preset-workspaces.md",
    "LICENSE",
    "README.md",
    "README.en.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "compatibility": {
      "dsh": "0.2.2-rc.5",
      "dshReleases": {
        "0.2.2-rc.5": "compatible",
        "0.2.3-alpha.2": "compatible"
      },
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "build": "node plugin-src/client/build.mjs && node plugin-src/host/build.mjs",
    "test": "node --test test/*.test.mjs test/channels/*/*.test.mjs",
    "check": "npm run build && npm test && node scripts/verify-package.mjs",
    "publish:index": "node scripts/publish-market-index.mjs",
    "pack:release": "node scripts/pack-release.mjs"
  },
  "engines": {
    "node": ">=22.19",
    "dsh": "^0.2.2-rc.5"
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.4",
    "qrcode": "1.5.4",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "esbuild": "0.25.9",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-test-renderer": "18.3.1",
    "semver": "7.8.5"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "test"
  },
  "optionalDependencies": {
    "sharp": "0.35.5"
  },
  "contributors": [
    {
      "name": "xmanrui",
      "url": "https://github.com/xmanrui"
    }
  ]
}
